{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022"],
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "resolveJsonModule": true,
        "allowImportingTsExtensions": false,
        "types": ["@cloudflare/workers-types", "node"]
    },
    "include": ["worker-configuration.d.ts", "src/**/*.ts", "test/**/*.ts"]
}
